; Engine configuration file.
; Generated for Godot 4.7 (.NET). Edit via the editor where possible --
; the editor rewrites this file and will drop unknown keys.

config_version=5

[application]

config/name="Endless Sky 3D"
config/description="Endless Sky reimplemented on Godot 4 (.NET): faithful data-driven simulation, low-poly 3D presentation."
config/version="0.1.0"
run/main_scene="res://scenes/flight.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

common/physics_ticks_per_second=60

[dotnet]

project/assembly_name="EndlessSky"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
