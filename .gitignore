# --- Godot 4 ---
# Engine-generated import cache + derived data. Always regenerable.
.godot/
/android/
*.translation

# --- Exported builds ---
# The global gitignore excludes `build/` wholesale; git will not re-include a
# file whose parent directory is excluded, so the directory must be un-excluded
# first, then its contents re-excluded.
!/build/
/build/*
!/build/.gdignore
/dist/

# --- .NET / C# ---
.mono/
data_*/
mono_crash.*.json
bin/
obj/
*.user
*.userprefs
.vs/
.idea/

# ...but `bin/` above matches ANY directory of that name, and gdUnit4 vendors its
# command-line runner in addons/gdUnit4/bin/. Excluding it meant a fresh clone had
# no way to run the in-engine suite at all: tools/test.ps1 -Suite godot died on
# "Can't load script: res://addons/gdUnit4/bin/GdUnitCmdTool.gd". Four files, 15K.
!/addons/gdUnit4/bin/

# --- Test + tool output ---
# .gdignore must survive a clone: it keeps Godot from importing report assets,
# which otherwise slows the next engine boot enough to time out the C# runner.
/reports/*
!/reports/.gdignore
/.gdunit4/
# Regenerated by the gdUnit4 C# test adapter on every `dotnet test`.
/gdunit4_testadapter_v5/
*.log

# --- Reference checkouts ---
# Upstream Endless Sky clone (behavioral + content ground truth). Never commit
# it; scripts/data extraction read from it, and CI fetches its own copy.
/external/

# --- OS ---
Thumbs.db
desktop.ini
.DS_Store

# Python bytecode from the world generator.
__pycache__/
*.pyc
