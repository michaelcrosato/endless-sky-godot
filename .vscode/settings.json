{
  // godot-tools drives "run current scene" and the GDScript debugger.
  // The *_console.exe variant is required so output reaches the terminal.
  //
  // MACHINE-SPECIFIC, and the one setting here that is: the path carries a Godot
  // version and a winget package hash, so it breaks on an engine upgrade and on
  // anyone else's machine. tools/_env.ps1 resolves the binary properly by globbing
  // the winget roots, and everything in tools/ uses that — this is only for the
  // extension, which wants a literal path. To refresh it after an upgrade:
  //     pwsh -NoProfile -Command '. tools/_env.ps1; $env:GODOT_BIN'
  // or set GODOT_BIN in your environment and leave this alone.
  "godotTools.editorPath.godot4": "C:/Program Files/WinGet/Packages/GodotEngine.GodotEngine.Mono_Microsoft.Winget.Source_8wekyb3d8bbwe/Godot_v4.7.2-stable_mono_win64/Godot_v4.7.2-stable_mono_win64_console.exe",

  // The GDScript language server runs inside the editor; start Godot
  // (pwsh tools/editor.ps1) before expecting completion or go-to-definition.
  "godotTools.lsp.serverHost": "127.0.0.1",
  "godotTools.lsp.serverPort": 6005,
  "godotTools.lsp.autoReconnect.enabled": true,

  "dotnet.defaultSolution": "EndlessSky.sln",

  "[gdscript]": {
    "editor.insertSpaces": false,
    "editor.detectIndentation": false
  },

  // Engine-generated caches: noisy in search, never worth editing by hand.
  "files.exclude": {
    "**/.godot": true,
    "**/bin": true,
    "**/obj": true,
    "**/gdunit4_testadapter_v5": true
  },
  "search.exclude": {
    "**/.godot": true,
    "**/addons/gdUnit4": true,
    "**/reports": true,
    "**/build": true
  },
  "files.associations": {
    "*.tscn": "ini",
    "*.tres": "ini",
    "*.godot": "ini"
  }
}
