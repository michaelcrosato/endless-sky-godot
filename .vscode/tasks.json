{
  "version": "2.0.0",
  "options": { "cwd": "${workspaceFolder}" },
  "presentation": { "panel": "dedicated", "clear": true },
  "tasks": [
    {
      "label": "godot: build",
      "detail": "Import assets and compile C#",
      "type": "shell",
      "command": "pwsh -NoProfile -File tools/build.ps1",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "godot: test (all)",
      "detail": "GDScript via gdUnit4 + C# via dotnet test",
      "type": "shell",
      "command": "pwsh -NoProfile -File tools/test.ps1",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "godot: test (simulation, engine-free)",
      "detail": "NUnit over libs/EndlessSky.{Data,Sim}; no engine, under a second",
      "type": "shell",
      "command": "pwsh -NoProfile -File tools/test.ps1 -Suite sim",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "godot: test (presentation, in-engine)",
      "detail": "gdUnit4 over src/game; boots a real engine process",
      "type": "shell",
      "command": "pwsh -NoProfile -File tools/test.ps1 -Suite godot",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "godot: run",
      "type": "shell",
      "command": "pwsh -NoProfile -File tools/run.ps1",
      "problemMatcher": []
    },
    {
      "label": "godot: run headless (smoke)",
      "type": "shell",
      "command": "pwsh -NoProfile -File tools/run.ps1 -Headless",
      "problemMatcher": []
    },
    {
      "label": "godot: run mission + combat smoke",
      "detail": "Takes a bounty, flies to it and fights it — the only check that drives libs/ and src/game/ together",
      "type": "shell",
      "command": "pwsh -NoProfile -File tools/run.ps1 -Headless -Frames 20000 -UserArgs '--mission-smoke'",
      "problemMatcher": []
    },
    {
      "label": "godot: run save round-trip smoke",
      "type": "shell",
      "command": "pwsh -NoProfile -File tools/run.ps1 -Headless -Frames 400 -UserArgs '--save-smoke'",
      "problemMatcher": []
    },
    {
      "label": "godot: open editor",
      "type": "shell",
      "command": "pwsh -NoProfile -File tools/editor.ps1",
      "problemMatcher": []
    },
    {
      "label": "godot: export (Windows, release)",
      "type": "shell",
      "command": "pwsh -NoProfile -File tools/export.ps1 -Preset 'Windows Desktop' -Release",
      "problemMatcher": []
    }
  ]
}
