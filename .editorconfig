root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Godot's GDScript formatter is tab-indented by convention.
[*.gd]
indent_style = tab
indent_size = 4

[*.{cs,csproj,sln}]
indent_style = space
indent_size = 4

[*.{tscn,tres,godot}]
indent_style = tab

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2
