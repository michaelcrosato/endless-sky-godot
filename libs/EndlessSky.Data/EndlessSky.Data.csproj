<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- No reference to GodotSharp, by design. The directive forbids mixing
       rendering with data/simulation; keeping this project engine-free makes
       that a compile error rather than a code-review question. -->

</Project>
